# Copiá este archivo a .env.backup y completalo. Está en .gitignore.
#
# Backblaze B2: crear un bucket PRIVADO (10 GB gratis) y una application key
# con acceso solo a ese bucket.
export RESTIC_REPOSITORY=b2:NOMBRE-DEL-BUCKET:micursada
export B2_ACCOUNT_ID=keyID-de-la-application-key
export B2_ACCOUNT_KEY=la-application-key

# La clave de cifrado del backup. GUARDALA TAMBIÉN FUERA DE LA VM (gestor de
# contraseñas): sin ella los backups no se pueden leer, ni siquiera vos.
export RESTIC_PASSWORD=una-frase-larga-que-no-uses-en-otro-lado

# Opcional: tópico de ntfy.sh para avisos de backup fallido al celular.
# Elegí un nombre impredecible (es la única "clave" del tópico).
# export NTFY_TOPIC=micursada-avisos-x7k2m9
