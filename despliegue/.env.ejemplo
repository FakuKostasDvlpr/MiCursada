# Copiá este archivo a .env (en esta misma carpeta) y completalo.
# .env está en .gitignore: nunca se commitea.

# El dominio que va a atender Caddy. Con DuckDNS: micursada.duckdns.org
DOMINIO=micursada.duckdns.org

# Usuarios del aula virtual habilitados para entrar, separados por coma.
# Es el username de Moodle (el que tipeás en el login), sin distinguir
# mayúsculas. Empezá solo con el tuyo; sumás gente agregándola acá y
# corriendo `docker compose up -d` de nuevo.
CURSADA_USUARIOS_PERMITIDOS=fcostas
